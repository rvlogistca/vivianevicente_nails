  <title>Vivi Chagas | Nail Designer — Nova Mamoré RO</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #10070d;
      --panel: #1b0c16;
      --pink: #ff4f9a;
      --pink-light: #ffc1dc;
      --gold: #d9b56d;
      --text: #fff5fa;
      --muted: #c5aeba;
      --line: #603047;
      --radius: 18px;
      --shadow: 0 15px 55px #0008;
      --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      min-height: 100vh;
      background: radial-gradient(ellipse at 50% 15%, #3b142a 0%, #190b14 45%, var(--bg) 80%);
      color: var(--text);
      font-family: Montserrat, system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }

    :focus-visible {
      outline: 2px solid var(--pink);
      outline-offset: 3px;
    }

    .page {
      width: min(1180px, 100%);
      margin: 0 auto;
      padding: 24px 22px 40px;
    }

    /* ========== HEADER ========== */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      position: relative;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-mark {
      width: 48px;
      height: 48px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: var(--pink);
      box-shadow: 0 0 24px #ff4f9a30, inset 0 0 15px #ff4f9a16;
      flex-shrink: 0;
    }

    .brand-mark svg { width: 26px; height: 26px; }

    .brand-name {
      font-family: "Cormorant Garamond", serif;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: 0.2px;
      line-height: 1.1;
    }

    .brand-name span { color: var(--pink-light); }

    .brand-sub {
      margin-top: 2px;
      color: var(--muted);
      font-size: 9px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
    }

    nav {
      display: flex;
      gap: 18px;
      align-items: center;
      flex-wrap: wrap;
    }

    nav a {
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.3px;
      transition: color var(--transition);
      position: relative;
    }

    nav a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 0;
      height: 1px;
      background: var(--pink-light);
      transition: width var(--transition);
    }

    nav a:hover,
    nav a:focus-visible {
      color: var(--pink-light);
    }

    nav a:hover::after,
    nav a:focus-visible::after {
      width: 100%;
    }

    .status {
      font-size: 10px;
      color: var(--pink-light);
      letter-spacing: 1.4px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .status::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--pink);
      box-shadow: 0 0 10px var(--pink);
      animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(0.85); }
    }

    /* ========== HERO ========== */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 48px;
      margin: 58px auto 40px;
      max-width: 1050px;
    }

    .hero-copy { padding: 12px 0; }

    .eyebrow {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 500;
    }

    h1 {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(46px, 6vw, 76px);
      font-weight: 500;
      line-height: 0.98;
      letter-spacing: -1px;
      margin: 16px 0 12px;
    }

    h1 span {
      color: var(--pink-light);
      font-style: italic;
    }

    .role {
      color: var(--pink);
      font-size: 12px;
      letter-spacing: 4px;
      font-weight: 600;
      margin-bottom: 18px;
    }

    .hero-copy > p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.9;
      max-width: 480px;
    }

    .slogan {
      font-family: "Cormorant Garamond", serif;
      color: var(--gold);
      font-size: 24px;
      font-style: italic;
      margin-top: 22px;
    }

    .cta-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border: 1px solid var(--pink);
      border-radius: 999px;
      padding: 14px 22px;
      background: linear-gradient(135deg, #ff4f9a, #c92c70);
      color: white;
      font-size: 11px;
      letter-spacing: 0.6px;
      font-weight: 700;
      box-shadow: 0 8px 30px #ff4f9a25;
      transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
      cursor: pointer;
    }

    .btn:hover,
    .btn:focus-visible {
      transform: translateY(-3px);
      box-shadow: 0 14px 36px #ff4f9a45;
    }

    .btn.secondary {
      background: transparent;
      border-color: #85536c;
      color: var(--text);
      box-shadow: none;
    }

    .btn.secondary:hover,
    .btn.secondary:focus-visible {
      border-color: var(--gold);
      color: var(--pink-light);
      background: #ff4f9a10;
    }

    /* Hero photo */
    .hero-photo-wrap {
      position: relative;
      width: min(100%, 440px);
      margin: 0 auto;
    }

    .hero-photo-wrap::before {
      content: "";
      position: absolute;
      inset: -14px 14px 14px -14px;
      border: 1px solid var(--gold);
      border-radius: 220px 220px 28px 28px;
      opacity: 0.75;
      pointer-events: none;
    }

    .hero-photo {
      width: 100%;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      object-position: center 30%;
      border-radius: 220px 220px 24px 24px;
      border: 2px solid #ffb5d04a;
      box-shadow: var(--shadow), 0 0 40px #ff4f9a18;
    }

    .photo-caption {
      position: absolute;
      bottom: 18px;
      left: -16px;
      background: #180a13f0;
      border: 1px solid #d9b56d80;
      padding: 12px 18px;
      border-radius: 4px;
      box-shadow: 0 8px 25px #0006;
      backdrop-filter: blur(8px);
    }

    .photo-caption strong {
      display: block;
      font-family: "Cormorant Garamond", serif;
      font-size: 20px;
      font-weight: 600;
    }

    .photo-caption span {
      font-size: 9px;
      letter-spacing: 2px;
      color: var(--pink-light);
      text-transform: uppercase;
    }

    /* ========== DEPOIMENTOS ========== */
    .testimonials {
      margin: 48px auto 10px;
      max-width: 1000px;
    }

    .testimonials-header {
      text-align: center;
      margin-bottom: 28px;
    }

    .testimonials-header .section-kicker {
      margin-bottom: 6px;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .testimonial-card {
      padding: 18px 16px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: linear-gradient(160deg, #25101de0, #140911f0);
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .testimonial-card:hover {
      transform: translateY(-4px);
      border-color: #ff5ca877;
      box-shadow: 0 10px 28px #ff5ca112;
    }

    .testimonial-stars {
      color: var(--gold);
      font-size: 13px;
      letter-spacing: 2px;
    }

    .testimonial-text {
      color: var(--muted);
      font-size: 12.5px;
      line-height: 1.7;
      font-style: italic;
      flex-grow: 1;
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 4px;
    }

    .testimonial-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ff4f9a55, #d9b56d44);
      border: 1px solid #ff5ca866;
      display: grid;
      place-items: center;
      font-size: 12px;
      font-weight: 600;
      color: var(--pink-light);
      flex-shrink: 0;
    }

    .testimonial-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      line-height: 1.2;
    }

    .testimonial-service {
      font-size: 10px;
      color: var(--pink-light);
      letter-spacing: 0.5px;
    }

    /* ========== LEGEND ========== */
    .legend {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin: 36px 0 20px;
    }

    .legend-item {
      padding: 18px 14px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #1a0b16d9;
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
    }

    .legend-item:hover {
      border-color: #ff5ca877;
      transform: translateY(-4px);
      box-shadow: 0 10px 28px #ff5ca115;
    }

    .legend-icon { color: var(--pink); width: 24px; height: 24px; }

    .legend-item b {
      display: block;
      font-size: 13px;
      margin: 8px 0 5px;
      font-weight: 600;
    }

    .legend-item span {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    /* ========== SECTIONS ========== */
    .section {
      margin: 80px auto 0;
      max-width: 1000px;
      text-align: center;
    }

    .section-kicker {
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 500;
    }

    h2 {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(32px, 4vw, 46px);
      font-weight: 500;
      margin: 10px 0 14px;
      line-height: 1.15;
    }

    .section-intro {
      max-width: 680px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.9;
    }

    /* Services */
    .services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 34px;
      text-align: left;
    }

    .service {
      position: relative;
      padding: 26px 22px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: linear-gradient(145deg, #25101dce, #140911e8);
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
    }

    .service:hover {
      transform: translateY(-6px);
      border-color: var(--pink);
      box-shadow: 0 12px 32px #ff4f9a15;
    }

    .service-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      border: 1px solid #d9b56d70;
      color: var(--pink-light);
      font-size: 20px;
      margin-bottom: 18px;
    }

    .service h3 {
      font-family: "Cormorant Garamond", serif;
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 10px;
    }

    .service p {
      color: var(--muted);
      font-size: 12.5px;
      line-height: 1.8;
    }

    .number {
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 2px;
      margin-bottom: 10px;
      font-weight: 500;
    }

    /* ========== PREÇOS ========== */
    .pricing {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 40px;
      text-align: left;
    }

    .price-card {
      position: relative;
      padding: 32px 26px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: linear-gradient(160deg, #25101de6, #140911f0);
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
      display: flex;
      flex-direction: column;
    }

    .price-card:hover {
      transform: translateY(-6px);
      border-color: var(--pink);
      box-shadow: 0 16px 40px #ff4f9a18;
    }

    .price-card.featured {
      border-color: var(--pink);
      background: linear-gradient(160deg, #3a1530e6, #1f0c18f0);
      box-shadow: 0 0 0 1px #ff4f9a40, 0 12px 40px #ff4f9a15;
    }

    .price-card.featured::before {
      content: "Mais pedido";
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, #ff4f9a, #c92c70);
      color: white;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .price-card h3 {
      font-family: "Cormorant Garamond", serif;
      font-size: 26px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .price-card .price {
      font-family: "Cormorant Garamond", serif;
      font-size: 42px;
      font-weight: 600;
      color: var(--pink-light);
      margin: 12px 0 6px;
      line-height: 1;
    }

    .price-card .price span {
      font-size: 16px;
      color: var(--muted);
      font-weight: 400;
      margin-right: 2px;
    }

    .price-card .price-note {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 20px;
    }

    .price-card ul {
      list-style: none;
      margin: 0 0 28px;
      flex-grow: 1;
    }

    .price-card li {
      font-size: 13px;
      color: var(--muted);
      padding: 8px 0;
      border-bottom: 1px solid #60304740;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .price-card li::before {
      content: "✓";
      color: var(--pink);
      font-weight: 700;
      flex-shrink: 0;
    }

    .price-card .btn {
      width: 100%;
      margin-top: auto;
    }

    /* ========== GALERIA AMPLIADA ========== */
    .gallery-section {
      margin-top: 80px;
      text-align: center;
    }

    .gallery-section h2 { margin-bottom: 10px; }

    .gallery-section > p {
      color: var(--muted);
      font-size: 13px;
      max-width: 600px;
      margin: 0 auto 28px;
      line-height: 1.8;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .gallery-card {
      height: 220px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: linear-gradient(145deg, #4b1934, #1a0b16);
      overflow: hidden;
      transition: transform var(--transition), border-color var(--transition);
      position: relative;
    }

    .gallery-card:nth-child(2) { background: linear-gradient(145deg, #5b3547, #21101a); }
    .gallery-card:nth-child(3) { background: linear-gradient(145deg, #7e3155, #26101d); }
    .gallery-card:nth-child(4) { background: linear-gradient(145deg, #3d1a2e, #180c14); }
    .gallery-card:nth-child(5) { background: linear-gradient(145deg, #5a2840, #1f1018); }
    .gallery-card:nth-child(6) { background: linear-gradient(145deg, #6b2a4a, #221018); }

    .gallery-card:hover {
      transform: translateY(-4px);
      border-color: #ff5ca877;
    }

    .nail {
      height: 78px;
      width: 30px;
      border-radius: 18px 18px 14px 14px;
      border: 1px solid #ffe4ef;
      background: linear-gradient(145deg, #fff1f6, #dc82ac);
      box-shadow: 0 8px 18px #0004;
      transform: rotate(-12deg);
      transition: transform 0.3s ease;
    }

    .gallery-card:hover .nail { transform: rotate(-8deg) scale(1.05); }

    .gallery-card:nth-child(2) .nail { background: linear-gradient(145deg, #f9e6d7, #bd8a9a); }
    .gallery-card:nth-child(3) .nail { background: linear-gradient(145deg, #ffcee2, #b92e6c); }
    .gallery-card:nth-child(4) .nail { background: linear-gradient(145deg, #e8d4c8, #a67c7c); }
    .gallery-card:nth-child(5) .nail { background: linear-gradient(145deg, #f5c6d8, #c45a8a); }
    .gallery-card:nth-child(6) .nail { background: linear-gradient(145deg, #ffe0f0, #e05a9a); }

    .gallery-label {
      position: absolute;
      bottom: 12px;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 11px;
      color: var(--pink-light);
      letter-spacing: 1px;
      text-transform: uppercase;
      opacity: 0.85;
    }

    /* About */
    .about {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 40px;
      align-items: center;
      text-align: left;
      margin-top: 80px;
      padding: 34px;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: #1b0c1680;
    }

    .about-art {
      min-height: 260px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: radial-gradient(circle, #59203f, #200d19 65%, #140811);
    }

    .about-art svg {
      width: 120px;
      height: 120px;
      color: var(--pink-light);
      filter: drop-shadow(0 0 18px #ff4f9a55);
    }

    .about-copy p {
      color: var(--muted);
      font-size: 13.5px;
      line-height: 1.95;
      margin-top: 12px;
    }

    .about-copy h2 { margin-bottom: 6px; }

    /* Pillars */
    .pillars {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 32px;
    }

    .pillar {
      padding: 24px 18px;
      border-top: 1px solid var(--gold);
      background: linear-gradient(180deg, #31122699, #16091270);
      transition: background var(--transition);
    }

    .pillar:hover {
      background: linear-gradient(180deg, #3a153099, #1a0c1570);
    }

    .pillar b {
      display: block;
      font-family: "Cormorant Garamond", serif;
      font-size: 22px;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .pillar span {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.7;
    }

    /* ========== FORMULÁRIO ========== */
    .form-section {
      margin-top: 80px;
      padding: 48px 32px;
      border: 1px solid #70405a;
      border-radius: 24px;
      background: radial-gradient(ellipse at 50% 0%, #59203b60, #1a0b15 70%);
      text-align: center;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      max-width: 640px;
      margin: 32px auto 0;
      text-align: left;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-group label {
      font-size: 12px;
      color: var(--pink-light);
      font-weight: 500;
      letter-spacing: 0.4px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      background: #140911e0;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 13px 16px;
      color: var(--text);
      font-family: inherit;
      font-size: 14px;
      transition: border-color var(--transition), box-shadow var(--transition);
      outline: none;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: #8a6b7a;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
